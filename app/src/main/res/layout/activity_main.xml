<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- ============================================================== -->
    <!-- MODE 0: DEFAULT CONTROLLER (Air Mouse + Trackpad + Media)     -->
    <!-- ============================================================== -->
    <LinearLayout
        android:id="@+id/layoutDefaultMode"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="28dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp"
        android:visibility="visible">

        <!-- Top Header with Menu Button & Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 3-Bars Hamburger Menu Button -->
            <FrameLayout
                android:id="@+id/btnMainMenu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/glass_button_primary"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="Menu"
                    android:src="@drawable/ic_menu_bars" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Air Mouse Pro"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvGyroIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:text="Gyro: Active (Auto-tracking)"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Status Badge -->
            <LinearLayout
                android:id="@+id/layoutStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/glass_card"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp">

                <View
                    android:id="@+id/viewStatusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/status_dot_disconnected" />

                <TextView
                    android:id="@+id/tvStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif"
                    android:text="@string/status_disconnected"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Connect & Pair Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMakeDiscoverable"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/glass_button_primary"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.02"
                android:stateListAnimator="@null"
                android:text="📡 PAIR / SWIFT PAIR"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnConnectPaired"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/glass_button_primary"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.02"
                android:stateListAnimator="@null"
                android:text="💻 CONNECT LAPTOP"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- System Controls Card (Volume & Brightness & Media) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/glass_card"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Volume & Brightness Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnVolDown"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/glass_button_secondary"
                    android:stateListAnimator="@null"
                    android:text="Vol −"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnVolMute"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/glass_button_secondary"
                    android:stateListAnimator="@null"
                    android:text="Mute"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnVolUp"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/glass_button_secondary"
                    android:stateListAnimator="@null"
                    android:text="Vol +"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnBrightDown"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/glass_button_secondary"
                    android:stateListAnimator="@null"
                    android:text="🔅 Dim"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnBrightUp"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/glass_button_secondary"
                    android:stateListAnimator="@null"
                    android:text="🔆 Bright"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Media Playback Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnMediaPrev"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:background="@drawable/glass_button_secondary"
                    android:stateListAnimator="@null"
                    android:text="⏮ Prev"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnMediaPlay"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/glass_button_secondary"
                    android:stateListAnimator="@null"
                    android:text="⏯ Play/Pause"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnMediaNext"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/glass_button_secondary"
                    android:stateListAnimator="@null"
                    android:text="⏭ Next"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Mouse Buttons (Left, Middle, Right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLeftClick"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/glass_button_primary"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"
                android:text="@string/click_left"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnMiddleClick"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/glass_button_primary"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"
                android:text="@string/click_middle"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnRightClick"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/glass_button_primary"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"
                android:text="@string/click_right"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Center Interaction Zone: Touch Surface & Scroll Strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Central Frosted Glass Touchpad -->
            <FrameLayout
                android:id="@+id/padAirClutch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/glass_air_clutch"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvClutchTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.04"
                        android:text="PRECISION TRACKPAD &amp; AIR MOUSE"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:text="1 Finger: Move • Tap: Left Click • Hold &amp; Drag\n2 Fingers: Tap for Right Click • Swipe to Scroll\nHardware: Vol Up = Left Click • Vol Down = Right Click"
                        android:textColor="@color/text_muted"
                        android:textSize="10.5sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Vertical Scroll Wheel Strip -->
            <FrameLayout
                android:id="@+id/padScrollStrip"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:background="@drawable/glass_scroll_strip"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="▲\n\nS\nC\nR\nO\nL\nL\n\n▼"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </FrameLayout>
        </LinearLayout>

        <!-- Bottom Controls: Sensitivity Slider & Pause Toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/glass_card"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSensitivityLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif"
                    android:text="Sensitivity: 100%"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/cbPauseGyro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/text_primary"
                    android:text="Pause Pointer"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekBarSensitivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:max="250"
                android:progress="100"
                android:progressTint="@color/text_primary"
                android:thumbTint="@color/text_primary" />
        </LinearLayout>

        <!-- Master Bluetooth Service Toggle -->
        <Button
            android:id="@+id/btnToggleService"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/glass_button_primary"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:stateListAnimator="@null"
            android:text="@string/btn_start_service"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

    </LinearLayout>

    <!-- ============================================================== -->
    <!-- MODE 1: FULLSCREEN TOUCHPAD (Dimmed Monarch Wallpaper)         -->
    <!-- ============================================================== -->
    <FrameLayout
        android:id="@+id/layoutFullscreenTouchpadMode"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Wallpaper Image (Default Monarch or User Custom) -->
        <ImageView
            android:id="@+id/ivTouchpadWallpaper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Touchpad Wallpaper"
            android:scaleType="centerCrop"
            android:src="@drawable/wallpaper_monarch" />

        <!-- Dynamic Dimming Overlay (Alpha adjusted via Settings) -->
        <View
            android:id="@+id/viewTouchpadDimOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000" />

        <!-- Subtle Right Edge Volume Scroll Bar Guide -->
        <View
            android:id="@+id/viewRightEdgeGuide"
            android:layout_width="16dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="#15FFFFFF" />

        <!-- Fullscreen Touchpad Gesture Surface -->
        <FrameLayout
            android:id="@+id/viewTouchpadSurface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true">

            <!-- Subtle Inset Info Card (Centered at top) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal|top"
                android:layout_marginTop="36dp"
                android:background="@drawable/glass_card"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif-medium"
                    android:text="FULLSCREEN PRECISION TRACKPAD"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="2dp"
                    android:text="1-Finger: Move / Tap / Hold &amp; Drag • 2-Finger: Right Click &amp; Scroll • Right Edge: Volume"
                    android:textColor="@color/text_muted"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <!-- On-Screen Volume HUD (Pops up when sliding right edge) -->
            <LinearLayout
                android:id="@+id/layoutVolumeHud"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/glass_dialog_background"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="16dp"
                android:paddingEnd="24dp"
                android:paddingBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvVolumeHudIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔊"
                    android:textSize="32sp" />

                <TextView
                    android:id="@+id/tvVolumeHudText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="VOLUME UP"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

        </FrameLayout>
    </FrameLayout>



    <!-- ============================================================== -->
    <!-- FLOATING SMART SIDEBAR / BALL HANDLE                           -->
    <!-- Auto-docks to screen wall after 1.9 seconds into arrow tab     -->
    <!-- ============================================================== -->
    <FrameLayout
        android:id="@+id/layoutFloatingSidebar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <!-- State A: Floating 3-Bar Glass Ball -->
        <FrameLayout
            android:id="@+id/viewFloatingBall"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/glass_floating_ball"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="Menu Ball"
                android:src="@drawable/ic_menu_bars" />
        </FrameLayout>

        <!-- State B: Docked Smart Sidebar Arrow Tab (OxygenOS Style) -->
        <FrameLayout
            android:id="@+id/viewFloatingArrowTab"
            android:layout_width="26dp"
            android:layout_height="64dp"
            android:background="@drawable/glass_sidebar_tab"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivSidebarArrow"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="Sidebar Arrow"
                android:src="@drawable/ic_arrow_right" />
        </FrameLayout>

    </FrameLayout>

    <!-- ============================================================== -->
    <!-- MENU OVERLAY DIALOG                                            -->
    <!-- ============================================================== -->
    <FrameLayout
        android:id="@+id/layoutMenuOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/glass_dialog_background"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Air Connect Pro Modes"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Choose your controller view:"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <!-- Option 1: Default Mode -->
            <Button
                android:id="@+id/btnMenuOptionDefault"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/glass_menu_item"
                android:gravity="center_vertical|start"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:stateListAnimator="@null"
                android:text="🏠  Default Controller\n     (Air Mouse, Pad &amp; Media)"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <!-- Option 2: Fullscreen Touchpad -->
            <Button
                android:id="@+id/btnMenuOptionFullscreen"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/glass_menu_item"
                android:gravity="center_vertical|start"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:stateListAnimator="@null"
                android:text="🖱️  Fullscreen Touchpad\n     (Monarch Wallpaper &amp; Edge Vol)"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />


            <!-- Option 4: Settings -->
            <Button
                android:id="@+id/btnMenuOptionSettings"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/glass_menu_item"
                android:gravity="center_vertical|start"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:stateListAnimator="@null"
                android:text="⚙️  Settings &amp; Wallpaper Dimming"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <!-- Close Button -->
            <Button
                android:id="@+id/btnMenuClose"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/glass_button_secondary"
                android:stateListAnimator="@null"
                android:text="✕ Close Menu"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

        </LinearLayout>
    </FrameLayout>

    <!-- ============================================================== -->
    <!-- SETTINGS OVERLAY DIALOG (Wallpaper, Dimming Live Preview, Sens)-->
    <!-- ============================================================== -->
    <FrameLayout
        android:id="@+id/layoutSettingsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ScrollView
            android:layout_width="340dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/glass_dialog_background"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="⚙️ Touchpad &amp; Wallpaper Settings"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp" />

                <!-- 1. Trackpad Sensitivity Slider -->
                <TextView
                    android:id="@+id/tvSettingsSensitivityLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Global Trackpad Sensitivity: 100%"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/seekBarSettingsSensitivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="250"
                    android:progress="100"
                    android:progressTint="@color/text_primary"
                    android:thumbTint="@color/text_primary" />

                <!-- 2. Wallpaper Selection Buttons -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Touchpad Wallpaper:"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnSetDefaultWallpaper"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:background="@drawable/glass_button_secondary"
                        android:stateListAnimator="@null"
                        android:text="Monarch (Default)"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnPickCustomWallpaper"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/glass_button_secondary"
                        android:stateListAnimator="@null"
                        android:text="📁 Pick from Gallery"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- 3. LIVE VISUAL PREVIEW OF WALLPAPER & DIMMING -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Wallpaper Live Dimming Preview:"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/glass_card">

                    <ImageView
                        android:id="@+id/ivPreviewWallpaper"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Live Preview Wallpaper"
                        android:scaleType="centerCrop"
                        android:src="@drawable/wallpaper_monarch" />

                    <!-- Live dynamic dim overlay on preview -->
                    <View
                        android:id="@+id/viewPreviewDim"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#000000" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:background="#66000000"
                        android:padding="6dp"
                        android:text="LIVE PREVIEW • HOW TOUCHPAD WILL LOOK"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp" />
                </FrameLayout>

                <!-- 4. Wallpaper Dimming Seekbar -->
                <TextView
                    android:id="@+id/tvSettingsDimLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Dimming Intensity: 55%"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/seekBarSettingsDim"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="90"
                    android:progress="55"
                    android:progressTint="@color/text_primary"
                    android:thumbTint="@color/text_primary" />

                <!-- 5. Right Edge Volume Scroll Checkbox -->
                <CheckBox
                    android:id="@+id/cbSettingsEdgeVolume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:buttonTint="@color/text_primary"
                    android:checked="true"
                    android:text="Right-Edge Vertical Drag for Volume"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <!-- Save & Done Button -->
                <Button
                    android:id="@+id/btnSettingsApply"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/glass_button_primary"
                    android:fontFamily="sans-serif-medium"
                    android:stateListAnimator="@null"
                    android:text="Apply &amp; Done"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

            </LinearLayout>
        </ScrollView>
    </FrameLayout>

</FrameLayout>
