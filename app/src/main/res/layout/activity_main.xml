<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="28dp"
    android:paddingEnd="16dp"
    android:paddingBottom="20dp">

    <!-- Top Status Header with Safe Area Margins -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Air Mouse Pro"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvGyroIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="Gyro: Active (Auto-tracking)"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Status Badge -->
        <LinearLayout
            android:id="@+id/layoutStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <View
                android:id="@+id/viewStatusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/status_dot_disconnected" />

            <TextView
                android:id="@+id/tvStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif"
                android:text="@string/status_disconnected"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Connect & Pair Buttons (Frosted Glass Row) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnMakeDiscoverable"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/glass_button_primary"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            android:stateListAnimator="@null"
            android:text="📡 PAIR / SWIFT PAIR"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnConnectPaired"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/glass_button_primary"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            android:stateListAnimator="@null"
            android:text="💻 CONNECT LAPTOP"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- System Controls Card (Frosted Glass) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/glass_card"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Volume & Brightness Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnVolDown"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/glass_button_secondary"
                android:stateListAnimator="@null"
                android:text="Vol −"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnVolMute"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/glass_button_secondary"
                android:stateListAnimator="@null"
                android:text="Mute"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnVolUp"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/glass_button_secondary"
                android:stateListAnimator="@null"
                android:text="Vol +"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnBrightDown"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/glass_button_secondary"
                android:stateListAnimator="@null"
                android:text="🔅 Dim"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnBrightUp"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/glass_button_secondary"
                android:stateListAnimator="@null"
                android:text="🔆 Bright"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Media Playback Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMediaPrev"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:background="@drawable/glass_button_secondary"
                android:stateListAnimator="@null"
                android:text="⏮ Prev"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnMediaPlay"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/glass_button_secondary"
                android:stateListAnimator="@null"
                android:text="⏯ Play/Pause"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnMediaNext"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/glass_button_secondary"
                android:stateListAnimator="@null"
                android:text="⏭ Next"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Mouse Buttons (Left, Middle, Right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnLeftClick"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/glass_button_primary"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="@string/click_left"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnMiddleClick"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/glass_button_primary"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="@string/click_middle"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnRightClick"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/glass_button_primary"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="@string/click_right"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Center Interaction Zone: Touch Surface & Scroll Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Central Frosted Glass Touchpad -->
        <FrameLayout
            android:id="@+id/padAirClutch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/glass_air_clutch"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvClutchTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:text="PRECISION TRACKPAD &amp; AIR MOUSE"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:text="1 Finger: Move • Tap: Left Click • Double-Tap: Drag\n2 Fingers: Tap for Right Click • Swipe to Scroll\nHardware: Vol Up = Left Click • Vol Down = Right Click"
                    android:textColor="@color/text_muted"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Vertical Scroll Wheel Strip -->
        <FrameLayout
            android:id="@+id/padScrollStrip"
            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:background="@drawable/glass_scroll_strip"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="▲\n\nS\nC\nR\nO\nL\nL\n\n▼"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </FrameLayout>
    </LinearLayout>

    <!-- Bottom Controls: Sensitivity Slider & Pause Toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/glass_card"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSensitivityLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:text="Sensitivity: 100%"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/cbPauseGyro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/text_primary"
                android:text="Pause Pointer"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekBarSensitivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:max="200"
            android:progress="100"
            android:progressTint="@color/text_primary"
            android:thumbTint="@color/text_primary" />
    </LinearLayout>

    <!-- Master Bluetooth Service Toggle -->
    <Button
        android:id="@+id/btnToggleService"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/glass_button_primary"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.04"
        android:stateListAnimator="@null"
        android:text="@string/btn_start_service"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

</LinearLayout>
